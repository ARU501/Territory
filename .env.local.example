# Copy this file to .env.local and fill in your Supabase project values.
# Get them from: Supabase dashboard -> Project Settings -> API
#
# Leave all three blank and the app runs in "solo mode": everything is stored
# in the browser on that one device, with no live team sync.

# Public. These are inlined into the browser bundle at build time, which is
# normal for Supabase - row-level security is what protects the data.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# SECRET. No NEXT_PUBLIC_ prefix, so it never reaches the browser. The
# /api/team-token route signs each team's access token with it; row-level
# security trusts the resulting claim. Treat it like a password.
SUPABASE_JWT_SECRET=
